# ==============================================================================
# RecoverAI — Environment Configuration Template
# Multi-Tenant Autonomous Revenue Recovery Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Options: development, test, staging, production
APP_ENV=production
APP_NAME=RecoverAI
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Public URLs (Used for customer recovery links, webhooks, and CORS)
APP_URL=https://app.recoverai.io
API_URL=https://api.recoverai.io
NEXT_PUBLIC_API_URL=https://api.recoverai.io

# Permitted CORS Origins (comma-separated list or single URL)
CORS_ORIGINS=https://app.recoverai.io,https://recoverai.io

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL (Production Recommended):
# DATABASE_URL=postgresql+asyncpg://postgres_user:strong_password@db-host.internal:5432/recoverai_prod
# SQLite (Local Dev / Test Fallback):
DATABASE_URL=sqlite+aiosqlite:///./recoverai.db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# High-entropy random 256-bit secret for signing JWTs (Generate: `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_256bit_random_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=recoverai_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 4. PAYMENT PROVIDER INTEGRATIONS (GENERIC PLACEHOLDERS)
# Note: In RecoverAI, merchants configure their credentials via the Dashboard UI.
# Backend gateway defaults or platform fallback keys can be supplied below:
# ------------------------------------------------------------------------------
# Stripe
STRIPE_API_KEY=sk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Razorpay / Secondary Processor
PAYMENT_GATEWAY_KEY=rzp_live_placeholder
PAYMENT_GATEWAY_SECRET=rzp_secret_placeholder
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# 5. COMMUNICATIONS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# SMTP / Email Gateway
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_smtp_key
EMAIL_FROM=RecoverAI Notifications <support@recoverai.io>

# SMS / WhatsApp Gateway
SMS_PROVIDER_API_KEY=placeholder_sms_key
WHATSAPP_BUSINESS_API_TOKEN=placeholder_whatsapp_token
